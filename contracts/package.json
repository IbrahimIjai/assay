{
  "name": "assay-protocol",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "circuit:compile": "circom2 circuit/reserve_coverage.circom --r1cs --wasm --sym --output circuit/build -l node_modules",
    "circuit:info": "snarkjs r1cs info circuit/build/reserve_coverage.r1cs",
    "circuit:witness": "node circuit/scripts/generate_witness.js",
    "test:js": "node circuit/scripts/test_witness.js"
  },
  "devDependencies": {
    "circom2": "0.2.23",
    "circomlib": "2.0.5",
    "snarkjs": "0.7.6"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1"
  }
}
